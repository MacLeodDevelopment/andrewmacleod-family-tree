<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

  <!-- Microsoft.Identity.Web 4.16.1 brings in 10.0.10, which has known vulnerabilities
       (GHSA-7hqp-7c5m-4vq6 and others). The API itself uses the ASP.NET Core shared
       framework's copy; this test project isn't a web project, so it needs the pin.
       Remove once Microsoft.Identity.Web depends on 10.0.13 or later. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FamilyTree.Api\FamilyTree.Api.csproj" />
  </ItemGroup>

</Project>
