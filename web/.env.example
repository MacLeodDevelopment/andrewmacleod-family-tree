# Copy to .env.local (ignored by git) to turn on sign-in in local development.
# Neither value is a secret, but both stay out of the repo. See docs/setup-entra.md.

# Client ID of the "Family Tree" Entra app registration (output of infra/entra.bicep).
VITE_ENTRA_CLIENT_ID=

# The Entra tenant (directory) ID.
VITE_ENTRA_TENANT_ID=

# Leave unset locally: the Vite dev server proxies API calls to http://localhost:5080.
# VITE_API_BASE_URL=
