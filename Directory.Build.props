<Project>

  <!-- Applies to every .NET project in the repo. -->
  <PropertyGroup>
    <!-- NuGet audit checks direct and transitive packages against GitHub's advisory
         database on every restore. Fail the build on moderate (NU1902), high (NU1903)
         and critical (NU1904) vulnerabilities instead of just warning. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

</Project>
