<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
  </ItemGroup>

  <!-- Microsoft.Data.SqlClient 6.1.7 (via EF Core) brings in 9.0.11, which has known
       vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Remove once SqlClient
       depends on a patched version itself. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
