<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Container image built with `dotnet publish -t:PublishContainer` (no Dockerfile).
       Chiseled images are minimal, have no shell and run as a non-root user. -->
  <PropertyGroup>
    <ContainerRepository>familytree-api</ContainerRepository>
    <ContainerFamily>noble-chiseled</ContainerFamily>
  </PropertyGroup>

</Project>
