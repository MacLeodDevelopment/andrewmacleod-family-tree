<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>df59c4cf-8615-4f92-ad07-9e4a897273e8</UserSecretsId>
  </PropertyGroup>

  <!-- Container image built with `dotnet publish -t:PublishContainer` (no Dockerfile).
       Chiseled images are minimal, have no shell and run as a non-root user. -->
  <PropertyGroup>
    <ContainerRepository>familytree-api</ContainerRepository>
    <ContainerFamily>noble-chiseled</ContainerFamily>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
  </ItemGroup>

  <!-- Pinned above the version Microsoft.Identity.Web 4.16.1 brings in (10.0.10), which
       has known vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Remove once
       Microsoft.Identity.Web depends on 10.0.13 or later itself. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
